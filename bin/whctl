#!/usr/bin/env ruby
# frozen_string_literal: true

require 'bundler/setup'
require_relative '../lib/walheim'

# Route commands based on first argument
if ARGV[0] == 'context'
  # Phase 1: Context commands use legacy OptionParser
  require_relative '../lib/walheim/cli/legacy_context'
  Walheim::LegacyContext.execute(ARGV)
else
  # Phase 1: Resource operations use Thor
  Walheim::CLI.register_operations
  Walheim::CLI.start(ARGV)
end
